classDiagram
    class LoginUserCommand {
        +string email
        +string pass
    }

    class LoginUserHandler {
        +handle(LoginUserCommand command)
    }

    class UserRepository {
        +findUserByEmail(string email)
    }

    class SessionManager {
        +setUser(int id, string email, int role)
    }

    class PasswordHasher {
        +verifyPassword(string pass, string hash)
    }

    LoginUserHandler --> LoginUserCommand
    LoginUserHandler --> UserRepository
    LoginUserHandler --> SessionManager
    LoginUserHandler --> PasswordHasher
