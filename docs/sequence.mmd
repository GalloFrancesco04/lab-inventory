=======CREATE LOAN========
sequenceDiagram
autonumber
actor A as Administrator
participant UI as UI
participant LS as LoanService
participant CS as ClientService
participant IS as InventoryService
participant DB as Database

A->>UI: Open "Create Loan"

UI->>CS: searchClients(query)
CS->>DB: findClients(query)
DB-->>CS: clientList
CS-->>UI: Results
A->>UI: Select client
UI->>CS: getClient(clientId)
CS->>DB: getClientById(clientId)
DB-->>CS: client
CS-->>UI: Client details

UI->>IS: searchObject(query)
IS->>DB: findObjects(query)
DB-->>IS: objectList
IS-->>UI: Results
A->>UI: Select object(s)

A->>UI: Confirm loan (dates, notes)
UI->>LS: createLoan(clientId, items, dates, notes)
LS->>DB: insertLoan(...)
DB-->>LS: loanId

loop For each selected item
  LS->>DB: insertLoanedObject(loanId, objectId/typeCode)
  DB-->>LS: ok
  LS->>DB: setObjectState(objectId, "Loaned")
  DB-->>LS: ok
end

LS-->>UI: loanCreated(loanId)
UI-->>A: Loan created


CS->>MAIL: sendLoanStatusNotification(clientEmail, status)
MAIL-->>CS: sent 


==============Close Loan============
sequenceDiagram
autonumber
actor A as Administrator
participant UI as UI
participant LS as LoanService
participant DB as Database

A->>UI: Open "Loan List"
UI->>LS: searchLoans(query)
LS->>DB: findLoans(query)
DB-->>LS: loanList
LS-->>UI: Results

A->>UI: Select loan
UI->>LS: getLoan(loanId)
LS->>DB: getLoanDetails(loanId)
DB-->>LS: loan + items
LS-->>UI: Loan details

A->>UI: Confirm close (returnDate, damaged flags)
UI->>LS: closeLoan(loanId, returnDate, damagedInfo)
LS->>DB: updateLoanClose(loanId, returnDate, state=closed)
DB-->>LS: ok

loop For each returned item
  alt Item damaged
    LS->>DB: setObjectState(objectId, "DAMAGED")
    DB-->>LS: ok
  else Item ok
    LS->>DB: setObjectState(objectId, "AVAILABLE")
    DB-->>LS: ok
  end
end

LS-->>UI: closedOK
UI-->>A: Loan closed


